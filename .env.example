# --- Your LLM API (any OpenAI-compatible chat completions endpoint) ---
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=genailab-maas-sonnet-4.6

# "native" = model calls the search tools itself (needs function-calling support)
# "rag"    = app searches the catalog first and gives results to the model (works with any chat model)
TOOL_MODE=native

# --- Optional ---
LLM_TIMEOUT=60
MAX_STEPS=8
CATALOG_PATH=data/products.csv
RATE_LIMIT_PER_MINUTE=20
# Comma-separated origins allowed to call the API from a browser (leave empty if the UI is served by this app)
ALLOWED_ORIGINS=

# --- Troubleshooting (optional) ---
# Show the real error in API responses instead of a generic message (turn off in production)
DEBUG_ERRORS=false
# Set false only if your internal gateway uses a self-signed certificate
LLM_VERIFY_SSL=true
# JSON of extra headers if your gateway needs them, e.g. {"x-api-key": "..."}
LLM_EXTRA_HEADERS=
